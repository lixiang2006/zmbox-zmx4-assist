<!-- Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V4 · WPF workbench · compact technical/minimal -->
<Window x:Class="ZmboxZmx4Assist.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZmboxZmx4Assist"
        Title="造梦盒子·造梦西游四辅助工具" Height="680" Width="1120" MinHeight="560" MinWidth="920"
        WindowStartupLocation="CenterScreen" Background="#0E171F" Foreground="#E7EEF4"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <SolidColorBrush x:Key="CanvasBrush" Color="#0E171F"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#16222D"/>
        <SolidColorBrush x:Key="FieldBrush" Color="#0E1A24"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#2B4050"/>
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#355065"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E7EEF4"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9AAFC0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#23B5A2"/>
        <SolidColorBrush x:Key="AccentInkBrush" Color="#06201D"/>
        <SolidColorBrush x:Key="FocusBrush" Color="#72E0D2"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F4C76F"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#FF9B9B"/>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource FocusBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#263C4E"/>
            <Setter Property="Foreground" Value="#DCE8F0"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#3D2A32"/>
            <Setter Property="Foreground" Value="#FFE0E0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CaretBrush" Value="{StaticResource FocusBrush}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboSurface" Background="{TemplateBinding Background}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="6" Padding="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
                                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="Center" TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <Path Grid.Column="1" Data="M 3 7 L 8 12 L 13 7" Stroke="#A9C0D0" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboSurface" Property="Opacity" Value="0.45"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="#16222D" BorderBrush="#3B596D" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0">
                                    <ScrollViewer CanContentScroll="True" MaxHeight="260" Padding="4">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#23404A"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#17574F"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ItemSurface" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="#0E1A24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#2B4050" BorderThickness="1" CornerRadius="6" Padding="2">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton><RepeatButton Opacity="0" Command="{x:Static ScrollBar.PageUpCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Background="#607C90"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="5"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Opacity="0" Command="{x:Static ScrollBar.PageDownCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/></Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite" Focusable="False" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0" Padding="0,5">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <DockPanel>
                                                <Path x:Name="Chevron" Data="M 1 2 L 5 6 L 9 2" Stroke="#A9C0D0" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="8" Margin="2,0,9,0" VerticalAlignment="Center"/>
                                                <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Expander}}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Content="{TemplateBinding Content}" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="18" Height="18" Background="{StaticResource FieldBrush}" BorderBrush="#607C90" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
                                <Path x:Name="Mark" Data="M 3 9 L 7 13 L 15 4" Stroke="{StaticResource AccentInkBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource FocusBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#1C2D39"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#163F3D"/><Setter TargetName="ItemSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ZMBOX ZMX4 ASSIST" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <Border Width="1" Height="16" Background="{StaticResource PanelBorderBrush}" Margin="11,0"/>
                    <TextBlock Text="造梦盒子 · 造梦西游四" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Border x:Name="StatusPill" Grid.Column="1" Background="#123D39" CornerRadius="6" Padding="10,5" Margin="16,0,0,0" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock x:Name="StatusText" Text="就绪 · F8 录制 / F9 回放 / F12 停止" Foreground="#C4F7EE" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="292"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="宏库" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="MacroCountText" Text="尚无宏" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="OpenMacrosFolderButton" Grid.Column="1" Content="文件夹" Style="{StaticResource QuietButton}" Click="OpenMacrosFolderButton_Click" Padding="9,4" MinHeight="30"/>
                    </Grid>
                    <TextBlock x:Name="MacroIssueText" Grid.Row="1" Visibility="Collapsed" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"/>
                    <ListBox x:Name="MacrosList" Grid.Row="2" Margin="0,8,0,8" SelectionChanged="MacrosList_SelectionChanged" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:MacroListItem}">
                                <Grid Margin="10,8">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MouseLeftButtonDown="MacroName_MouseLeftButtonDown">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRenaming}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Visibility="{Binding IsRenaming, Converter={StaticResource VisibleWhenTrue}}" PreviewKeyDown="MacroRenameText_PreviewKeyDown" LostKeyboardFocus="MacroRenameText_LostKeyboardFocus"/>
                                    <TextBlock Grid.Row="1" Text="{Binding DetailLine}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3">
                        <Border Height="1" Background="{StaticResource PanelBorderBrush}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="SelectedMacroText" Text="新录制将保存为下列名称" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="MacroNameText" Text="刷图宏" MaxLength="80" Margin="0,0,0,7"/>
                        <UniformGrid Columns="2">
                            <Button x:Name="RecordButton" Content="开始录制 (F8)" Click="RecordButton_Click" Margin="0,0,6,0"/>
                            <Button x:Name="DeleteMacroButton" Content="删除选中宏" Style="{StaticResource QuietButton}" Click="DeleteMacroButton_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="回放工作台" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PreflightTitleText" Text="造梦盒子《造梦西游四》运行前检查" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="CheckTargetButton" Content="检查" Style="{StaticResource QuietButton}" Click="CheckTargetButton_Click" Padding="9,4" MinHeight="30"/>
                                <Button x:Name="SelectWindowButton" Content="锁定窗口" Click="SelectWindowButton_Click" Margin="7,0,0,0" Padding="10,4" MinHeight="30"/>
                            </StackPanel>
                        </Grid>
                        <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,9,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="状态" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="PreflightDetailText" Text="尚未执行检查。" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="窗口与布局" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="TargetWindowText" Foreground="{StaticResource TextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="LayoutText" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="输入通道" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="ChannelText" Foreground="{StaticResource TextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="目标" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Top"/>
                            <TextBlock x:Name="SelectedWindowText" Grid.Column="1" Text="开始回放会给出 3 秒倒计时；请在结束前点击要回放的游戏窗口。" Foreground="{StaticResource TextBrush}" FontSize="11" TextWrapping="Wrap" Margin="9,0,0,0"/>
                            <ComboBox x:Name="ProfilesCombo" Visibility="Collapsed" DisplayMemberPath="Name" SelectionChanged="ProfilesCombo_SelectionChanged"/>
                            <Button x:Name="CloneProfileButton" Visibility="Collapsed" Content="复制配置" Style="{StaticResource QuietButton}" Click="CloneProfileButton_Click"/>
                        </Grid>

                        <Border Background="#13232D" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,11,0,0">
                            <StackPanel>
                                <TextBlock Text="回放" FontSize="16" FontWeight="SemiBold"/>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="62"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="循环" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="RepeatText" Text="1" Grid.Column="1" Margin="7,0,0,0"/>
                                    <CheckBox x:Name="InfiniteCheck" Grid.Column="2" Content="无限" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <TextBlock Text="每轮等待" Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="18,0,0,0"/>
                                    <TextBox x:Name="InterIterationDelayText" Text="15" Grid.Column="4" Margin="7,0,0,0"/>
                                    <TextBlock Text="秒" Grid.Column="5" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="7,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="速度" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                    <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="0.9" Maximum="1.1" Value="1" TickFrequency="0.01" IsSnapToTickEnabled="True" Margin="9,0"/>
                                    <TextBlock x:Name="SpeedText" Grid.Column="2" Text="1.00x" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button x:Name="PlayButton" Content="开始回放 (F9)" Click="PlayButton_Click"/>
                                    <Button x:Name="StopButton" Grid.Column="2" Content="紧急停止 (F12)" Style="{StaticResource DangerButton}" Click="StopButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Expander Header="回放与冷却设置">
                            <StackPanel Margin="0,8,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="60"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="周期冷却" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="CooldownEveryIterationsText" Text="10" Grid.Column="1" Margin="7,0,0,0"/>
                                    <TextBlock Text="轮后等待" Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"/>
                                    <TextBox x:Name="CooldownSecondsText" Text="60" Grid.Column="3" Margin="7,0,0,0"/>
                                    <TextBlock Text="秒（0 关闭）" Grid.Column="4" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="7,0,0,0"/>
                                </Grid>
                                <TextBlock Text="冷却仅缓解节奏漂移；不会判断是否已进入正确关卡。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                                <TextBlock Text="回放通道" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,4"/>
                                <ComboBox x:Name="PlaybackModeCombo" SelectedIndex="0" SelectionChanged="PlaybackModeCombo_SelectionChanged">
                                    <ComboBoxItem Content="前台系统输入"/>
                                    <ComboBoxItem x:Name="BackgroundModeItem" Content="实验性后台窗口消息"/>
                                </ComboBox>
                                <TextBlock x:Name="BackgroundStatusText" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" FontSize="11" Margin="0,5,0,0"/>
                                <Border Height="1" Background="{StaticResource PanelBorderBrush}" Margin="0,12,0,9"/>
                                <TextBlock Text="后台兼容性" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="只在无破坏性验证后标记结果。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,6"/>
                                <WrapPanel>
                                    <Button x:Name="BackgroundPassedButton" Content="标记通过" Style="{StaticResource QuietButton}" Click="BackgroundPassedButton_Click" MinHeight="30"/>
                                    <Button x:Name="BackgroundFailedButton" Content="标记不支持" Style="{StaticResource QuietButton}" Click="BackgroundFailedButton_Click" Margin="7,0,0,0" MinHeight="30"/>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="目标与热键">
                            <StackPanel Margin="0,8,0,2">
                                <TextBlock Text="固定目标：造梦盒子《造梦西游四》。路径在锁定窗口时自动记忆。" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                                <TextBox x:Name="ProfileNameText" Visibility="Collapsed"/>
                                <TextBlock Text="启动器 EXE 路径" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,3"/>
                                <TextBox x:Name="ExecutablePathText" IsReadOnly="True"/>
                                <TextBlock Text="窗口标题须包含" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,3"/>
                                <TextBox x:Name="WindowTitleText" IsReadOnly="True"/>
                                <Button x:Name="SaveProfileButton" Visibility="Collapsed" Content="保存配置档" Style="{StaticResource QuietButton}" Click="SaveProfileButton_Click"/>
                                <Border Height="1" Background="{StaticResource PanelBorderBrush}" Margin="0,12,0,9"/>
                                <TextBlock Text="全局热键" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="点击输入框后按组合键；控制热键不会写入宏。" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="148"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="148"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="录制" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="RecordHotkeyText" Grid.Column="1" Margin="7,0,0,0" Text="F8" IsReadOnly="True" GotKeyboardFocus="HotkeyCapture_GotKeyboardFocus" LostKeyboardFocus="HotkeyCapture_LostKeyboardFocus" PreviewKeyDown="HotkeyCapture_PreviewKeyDown"/>
                                    <TextBlock Text="回放" Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="PlayHotkeyText" Grid.Column="4" Margin="7,0,0,0" Text="F9" IsReadOnly="True" GotKeyboardFocus="HotkeyCapture_GotKeyboardFocus" LostKeyboardFocus="HotkeyCapture_LostKeyboardFocus" PreviewKeyDown="HotkeyCapture_PreviewKeyDown"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="148"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="急停" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="EmergencyHotkeyText" Grid.Column="1" Margin="7,0,0,0" Text="F12" IsReadOnly="True" GotKeyboardFocus="HotkeyCapture_GotKeyboardFocus" LostKeyboardFocus="HotkeyCapture_LostKeyboardFocus" PreviewKeyDown="HotkeyCapture_PreviewKeyDown"/>
                                    <Button x:Name="SaveHotkeysButton" Grid.Column="3" Content="保存热键" Style="{StaticResource QuietButton}" Click="SaveHotkeysButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Margin="2,10,2,0" Foreground="#8EA4B5" FontSize="11" Text="录制仅在目标窗口前台进行；目标失效、布局超出容差或前台丢失会暂停并尝试恢复。宏与配置仅保存在本机。"/>
    </Grid>
</Window>
