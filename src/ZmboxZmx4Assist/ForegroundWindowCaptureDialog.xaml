<Window x:Class="ZmboxZmx4Assist.ForegroundWindowCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="锁定回放窗口" Width="470" Height="330" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#0E171F" Foreground="#E7EEF4"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#16222D"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9AAFC0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#23B5A2"/>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Background" Value="#263C4E"/>
            <Setter Property="Foreground" Value="#DCE8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="锁定当前前台窗口" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock Text="请在倒计时结束前，手动点击要回放的游戏窗口。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Margin="0,20" Padding="18">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="还剩" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="CountdownText" Text="3" FontSize="64" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="CaptureHintText" Text="倒计时结束时会锁定当前前台窗口。" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RetryButton" Content="重新倒计时" Click="RetryButton_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
            <Button Content="取消" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
